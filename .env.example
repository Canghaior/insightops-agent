# DeepSeek Chat Model
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
# DeepSeek uses Spring AI's OpenAI-compatible protocol adapter.
# Keep `none` in the safe template; change it to `openai` when enabling DeepSeek locally.
SPRING_AI_MODEL_CHAT=none
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
# Fixed-prompt online smoke endpoint. Keep false except during an explicit local test.
DEEPSEEK_SMOKE_TEST_ENABLED=false

# Cost audit baseline. USD token prices come from DeepSeek's model pricing page;
# USD_TO_CNY is an internal planning rate, not the provider's settlement rate.
DEEPSEEK_PRICING_EFFECTIVE_DATE=2026-08-16
DEEPSEEK_PRICING_USD_TO_CNY=7.20
DEEPSEEK_INPUT_CACHE_HIT_USD_PER_MILLION=0.0028
DEEPSEEK_INPUT_CACHE_MISS_USD_PER_MILLION=0.14
DEEPSEEK_OUTPUT_USD_PER_MILLION=0.28

# Model execution limits
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_READ_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_RUN_TIMEOUT_SECONDS=90
MODEL_MAX_TOOL_ROUNDS=4
MODEL_MONTHLY_BUDGET_CNY=20

# Embedding is intentionally disabled in P0.
# Select a separate provider and fixed vector dimension before the RAG phase.
EMBEDDING_ENABLED=false
SPRING_AI_MODEL_EMBEDDING=none
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_BATCHES_PER_CYCLE=50
EMBEDDING_LOCK_MINUTES=10
EMBEDDING_MAX_RETRIES=3
EMBEDDING_RETRY_MINUTES=2
EMBEDDING_INITIAL_DELAY_MS=15000
EMBEDDING_POLL_DELAY_MS=10000
EMBEDDING_MINIMUM_SCORE=0.35
RAG_ENABLED=false
RAG_CANDIDATE_LIMIT=12
RAG_MAX_EVIDENCE_CHUNKS=6
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MAX_CONTEXT_CHARACTERS=12000

# P1.4-E repeatable RAG quality gates. Retrieval metrics always run locally;
# generation and faithfulness judging use the configured DeepSeek model only when requested.
RAG_EVAL_MIN_RECALL_AT_K=0.90
RAG_EVAL_MIN_MRR=0.65
RAG_EVAL_MIN_TERM_COVERAGE=0.55
RAG_EVAL_MIN_NO_ANSWER_ACCURACY=1.0
RAG_EVAL_MIN_CITATION_PRECISION=0.90
RAG_EVAL_MIN_CITATION_COVERAGE=0.50
RAG_EVAL_MIN_FAITHFULNESS=0.75

# Local PostgreSQL; these are development-only defaults.
POSTGRES_DB=insightops
POSTGRES_USER=insightops
POSTGRES_PASSWORD=insightops_dev
POSTGRES_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/insightops
DB_USERNAME=insightops
DB_PASSWORD=insightops_dev

# Local application ports
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18080
WORKER_PORT=18081

# P1.2 GitHub Release collection. The Worker incrementally refreshes watched projects.
RELEASE_COLLECTION_ENABLED=true
RELEASE_COLLECTION_BATCH_SIZE=3
RELEASE_COLLECTION_INTERVAL_HOURS=6
RELEASE_COLLECTION_LOCK_MINUTES=5
RELEASE_COLLECTION_INITIAL_DELAY_MS=3000
RELEASE_COLLECTION_POLL_DELAY_MS=30000

# P1.3 model analysis. Existing releases remain manual-only after V11; new releases are eligible.
INTELLIGENCE_ANALYSIS_ENABLED=true
INTELLIGENCE_ANALYSIS_DAILY_LIMIT=5
INTELLIGENCE_ANALYSIS_BATCH_SIZE=2
INTELLIGENCE_ANALYSIS_LOCK_MINUTES=5
INTELLIGENCE_ANALYSIS_MAX_RETRIES=2
INTELLIGENCE_ANALYSIS_MAX_OUTPUT_TOKENS=1600
INTELLIGENCE_ANALYSIS_INITIAL_DELAY_MS=10000
INTELLIGENCE_ANALYSIS_POLL_DELAY_MS=30000
INTELLIGENCE_DIGEST_INITIAL_DELAY_MS=15000
INTELLIGENCE_DIGEST_POLL_DELAY_MS=300000

# P1.4-A official-document collection. Disabled by default; a system administrator must
# first queue a registered source in the Knowledge Collection page.
DOCUMENT_COLLECTION_ENABLED=false
DOCUMENT_COLLECTION_BATCH_SIZE=1
DOCUMENT_COLLECTION_INTERVAL_HOURS=24
DOCUMENT_COLLECTION_LOCK_MINUTES=10
DOCUMENT_CRAWL_MAX_PAGES_PER_SOURCE=200
DOCUMENT_CRAWL_MAX_DEPTH=4
DOCUMENT_CRAWL_MAX_BYTES_PER_PAGE=8388608
DOCUMENT_CRAWL_REQUEST_TIMEOUT_SECONDS=20
DOCUMENT_CRAWL_REQUEST_DELAY_MS=500
DOCUMENT_CHUNK_MAX_TOKENS=600
DOCUMENT_CHUNK_OVERLAP_TOKENS=80
DOCUMENT_COLLECTION_INITIAL_DELAY_MS=20000
DOCUMENT_COLLECTION_POLL_DELAY_MS=60000

# P1 first system administrator. Set these only in the ignored .env file.
# At startup this account is created/promoted to SYSTEM_ADMIN + OWNER. The password is
# used only when no credential exists, so restarting cannot overwrite a changed password.
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=alpha-owner
AUTH_BOOTSTRAP_DISPLAY_NAME=Alpha Owner
AUTH_BOOTSTRAP_PASSWORD=
AUTH_SESSION_DAYS=14
AUTH_SECURE_COOKIE=false
