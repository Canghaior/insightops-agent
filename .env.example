# DeepSeek Chat Model
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
# DeepSeek uses Spring AI's OpenAI-compatible protocol adapter.
# Keep `none` in the safe template; change it to `openai` when enabling DeepSeek locally.
SPRING_AI_MODEL_CHAT=none
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_TEMPERATURE=0.2
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
# Fixed-prompt online smoke endpoint. Keep false except during an explicit local test.
DEEPSEEK_SMOKE_TEST_ENABLED=false

# Cost audit baseline. USD token prices come from DeepSeek's model pricing page;
# USD_TO_CNY is an internal planning rate, not the provider's settlement rate.
DEEPSEEK_PRICING_EFFECTIVE_DATE=2026-08-16
DEEPSEEK_PRICING_USD_TO_CNY=7.20
DEEPSEEK_INPUT_CACHE_HIT_USD_PER_MILLION=0.0028
DEEPSEEK_INPUT_CACHE_MISS_USD_PER_MILLION=0.14
DEEPSEEK_OUTPUT_USD_PER_MILLION=0.28

# Model execution limits
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_READ_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_RUN_TIMEOUT_SECONDS=90
MODEL_MAX_TOOL_ROUNDS=4
MODEL_MONTHLY_BUDGET_CNY=20

# Embedding is intentionally disabled in P0.
# Select a separate provider and fixed vector dimension before the RAG phase.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Local PostgreSQL; these are development-only defaults.
POSTGRES_DB=insightops
POSTGRES_USER=insightops
POSTGRES_PASSWORD=insightops_dev
POSTGRES_PORT=55432
DB_URL=jdbc:postgresql://localhost:55432/insightops
DB_USERNAME=insightops
DB_PASSWORD=insightops_dev

# Local application ports
SERVER_PORT=18080
WORKER_PORT=18081
