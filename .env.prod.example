# Copy to .env.prod on the server. Never commit .env.prod.
COMPOSE_PROJECT_NAME=insightops-prod
IMAGE_TAG=latest
# Leave empty on the 8 GB starter server. Set to observability after core services are stable.
COMPOSE_PROFILES=
APP_ADDRESS=http://localhost
HTTP_PORT=8088
HTTPS_PORT=8443

# Safe defaults for a 4-core/8-GB server with 4 GB swap.
POSTGRES_MEMORY_LIMIT=768M
OLLAMA_MEMORY_LIMIT=2G
SERVER_MEMORY_LIMIT=2G
WORKER_MEMORY_LIMIT=2G
WEB_MEMORY_LIMIT=128M
CADDY_MEMORY_LIMIT=128M
PROMETHEUS_MEMORY_LIMIT=384M
ALERTMANAGER_MEMORY_LIMIT=128M
GRAFANA_MEMORY_LIMIT=384M

POSTGRES_DB=insightops
POSTGRES_USER=insightops
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_URL=jdbc:postgresql://postgres:5432/insightops
DB_USERNAME=insightops
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD

AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_USERNAME=alpha-owner
AUTH_BOOTSTRAP_DISPLAY_NAME="Alpha Owner"
AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_OWNER_PASSWORD
AUTH_SESSION_DAYS=14
AUTH_SECURE_COOKIE=false
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCK_MINUTES=15

DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
SPRING_AI_MODEL_CHAT=none
MODEL_RUN_TIMEOUT_SECONDS=90
MODEL_MAX_TOOL_ROUNDS=4
AGENT_TOOL_RESILIENCE_ENABLED=true
AGENT_TOOL_MAX_ATTEMPTS=3
AGENT_RUN_MAX_TOOL_ATTEMPTS=8
AGENT_RUN_TIMEOUT_SECONDS=90
AGENT_RUN_MAX_TOOL_DURATION_SECONDS=60
AGENT_TOOL_RETRY_INITIAL_DELAY_MS=250
AGENT_TOOL_RETRY_MAX_DELAY_MS=2000
AGENT_TOOL_POLL_INTERVAL_MS=100
AGENT_TOOL_CIRCUIT_WINDOW_SIZE=10
AGENT_TOOL_CIRCUIT_MINIMUM_CALLS=5
AGENT_TOOL_CIRCUIT_FAILURE_RATE_PERCENT=50
AGENT_TOOL_CIRCUIT_OPEN_SECONDS=30
AGENT_TOOL_CIRCUIT_HALF_OPEN_PERMITS=2
# P2.3-A durable Agent evaluation queue and lease takeover.
AGENT_EVALUATION_QUEUE_ENABLED=true
AGENT_EVALUATION_QUEUE_CONCURRENCY=1
AGENT_EVALUATION_QUEUE_POLL_INTERVAL_MS=2000
AGENT_EVALUATION_QUEUE_INITIAL_DELAY_MS=1000
AGENT_EVALUATION_QUEUE_LEASE_SECONDS=180
AGENT_EVALUATION_QUEUE_HEARTBEAT_SECONDS=30
AGENT_EVALUATION_QUEUE_MAX_ATTEMPTS=3
# P2.3-B/C durable chat execution, lease takeover and SLO sampling.
AGENT_CHAT_QUEUE_ENABLED=true
AGENT_CHAT_QUEUE_CONCURRENCY=2
AGENT_CHAT_QUEUE_POLL_INTERVAL_MS=500
AGENT_CHAT_QUEUE_INITIAL_DELAY_MS=1000
AGENT_CHAT_QUEUE_LEASE_SECONDS=30
AGENT_CHAT_QUEUE_RUN_TIMEOUT_SECONDS=90
AGENT_CHAT_QUEUE_HEARTBEAT_SECONDS=5
AGENT_CHAT_QUEUE_MAX_ATTEMPTS=3
AGENT_CHAT_QUEUE_EVENT_POLL_MS=200
AGENT_CHAT_QUEUE_SNAPSHOT_INTERVAL_MS=15000
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_ENABLED=false
MODEL_MONTHLY_BUDGET_CNY=20

EMBEDDING_ENABLED=true
SPRING_AI_MODEL_EMBEDDING=ollama
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=http://ollama:11434
RAG_ENABLED=true

RELEASE_COLLECTION_ENABLED=true
INTELLIGENCE_ANALYSIS_ENABLED=true
DOCUMENT_COLLECTION_ENABLED=true
KNOWLEDGE_UPLOAD_MAX_FILE_SIZE=20MB
KNOWLEDGE_UPLOAD_MAX_REQUEST_SIZE=22MB
KNOWLEDGE_UPLOAD_MAX_FILE_BYTES=20971520
KNOWLEDGE_UPLOAD_WORKSPACE_QUOTA_BYTES=1073741824
KNOWLEDGE_UPLOAD_MAX_PDF_PAGES=500
KNOWLEDGE_UPLOAD_MAX_EXTRACTED_CHARACTERS=2000000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
BACKUP_RETENTION_DAYS=30
# Set an approved HTTPS Alertmanager receiver before deployment. Keep the offsite passphrase
# empty on first deployment; the reliability bootstrap generates a 256-bit value locally.
ALERT_WEBHOOK_URL=
OFFSITE_BACKUP_PASSPHRASE=

# Local compose validation may keep this true. Set false before public deployment.
ALLOW_INSECURE_LOCAL=true
# Optional but strongly recommended for GitHub rate limits and Security Advisory access.
GITHUB_TOKEN=
