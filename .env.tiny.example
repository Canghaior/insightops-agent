# Copy to .env.tiny on the VPS and chmod 600. Never commit the real file.
COMPOSE_PROJECT_NAME=insightops-prod
IMAGE_TAG=latest
# Set after building a local server image containing the no-model startup fix.
# TINY_SERVER_IMAGE=insightops-agent-server:tiny-local
APP_ADDRESS=insightops.canghaior.com
APP_PUBLIC_URL=https://insightops.canghaior.com
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=insightops
POSTGRES_USER=insightops
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
DB_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
# If restoring old data, retain the original encryption keys when they differed
# from the old DB_PASSWORD. Leave blank for a fresh installation.
DELIVERY_ENCRYPTION_KEY=
IDENTITY_ENCRYPTION_KEY=

# Use true only to create the first owner on a fresh database. Disable it after first login.
AUTH_BOOTSTRAP_ENABLED=true
AUTH_BOOTSTRAP_USERNAME=alpha-owner
AUTH_BOOTSTRAP_DISPLAY_NAME=Alpha Owner
AUTH_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_OWNER_PASSWORD
AUTH_SECURE_COOKIE=true

# Set these three lines to a real API key, true, and openai to enable basic chat.
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=false
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_PRICING_EFFECTIVE_DATE=2026-09-10
# Conservative peak USD price per million tokens (recheck official pricing periodically).
DEEPSEEK_INPUT_CACHE_HIT_USD_PER_MILLION=0.006
DEEPSEEK_INPUT_CACHE_MISS_USD_PER_MILLION=0.30
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.20
SPRING_AI_MODEL_CHAT=none

# Keep public registration and mail-based features off during the first launch.
PUBLIC_BETA_ENABLED=false
IDENTITY_MAIL_ENABLED=false
