{
    admin off
}

{$APP_ADDRESS:http://localhost} {
    @not_chat_stream not path /api/v1/chat/streams*
    encode @not_chat_stream zstd gzip

    @chat_stream path /api/v1/chat/streams*
    handle @chat_stream {
        reverse_proxy server:18080 {
            flush_interval -1
        }
    }

    @api path /api/*
    handle @api {
        reverse_proxy server:18080
    }

    handle {
        reverse_proxy web:8080
    }

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }

    request_body {
        max_size 22MB
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 20MiB
            roll_keep 10
            roll_keep_for 336h
        }
        format json
    }
}

http://127.0.0.1:2019 {
    respond /healthz 200
}
