{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries", "title": "HTTP requests / second", "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries", "title": "HTTP p95 latency", "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries", "title": "JVM heap used", "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries", "title": "Database pool", "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by (job) (hikaricp_connections_active)", "legendFormat": "active {{job}}"},
        {"expr": "sum by (job) (hikaricp_connections_pending)", "legendFormat": "pending {{job}}"}
      ]
    },
    {
      "type": "timeseries", "title": "Agent tool outcomes", "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "sum by (tool, outcome) (rate(insightops_agent_tool_calls_total[5m]))", "legendFormat": "{{tool}} · {{outcome}}"}]
    },
    {
      "type": "timeseries", "title": "Agent tool p95 latency", "id": 6,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, tool) (rate(insightops_agent_tool_duration_seconds_bucket[5m])))", "legendFormat": "{{tool}}"}]
    },
    {
      "type": "timeseries", "title": "Agent retries and timeouts", "id": 7,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [
        {"expr": "sum by (tool) (rate(insightops_agent_tool_retries_total[5m]))", "legendFormat": "retry · {{tool}}"},
        {"expr": "sum by (tool) (rate(insightops_agent_tool_timeouts_total[5m]))", "legendFormat": "timeout · {{tool}}"}
      ]
    },
    {
      "type": "timeseries", "title": "Agent upstream circuit state", "id": 8,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "targets": [{"expr": "max by (group) (insightops_agent_tool_circuit_state)", "legendFormat": "{{group}} (0 closed / 1 half / 2 open)"}]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["insightops"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "InsightOps Overview",
  "uid": "insightops-overview",
  "version": 1
}
