{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries", "title": "HTTP requests / second", "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "sum by (job) (rate(http_server_requests_seconds_count[5m]))", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries", "title": "HTTP p95 latency", "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries", "title": "JVM heap used", "id": 3,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "{{job}}"}]
    },
    {
      "type": "timeseries", "title": "Database pool", "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "sum by (job) (hikaricp_connections_active)", "legendFormat": "active {{job}}"},
        {"expr": "sum by (job) (hikaricp_connections_pending)", "legendFormat": "pending {{job}}"}
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 41,
  "tags": ["insightops"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
